# Enterprise Multi-Cloud Remote State Backend Architecture
# Demonstrates remote state storage and state locking to prevent configuration drift.

# Option A: AWS S3 Backend with DynamoDB State Locking
terraform {
  backend "s3" {
    bucket         = "multicloud-terraform-state-prod"
    key            = "infrastructure/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "terraform-lock-table"
    encrypt        = true
  }
}

